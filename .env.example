# Application
APP_PORT=8000
WEB_CONCURRENCY=4
API_URL=
UPLOAD_DIR=/app/uploads
UPLOAD_HOST_DIR=/home/azureuser/uploads

# PostgreSQL (Azure or any hosted instance)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=exim_prod
POSTGRES_HOST=
POSTGRES_PORT=5432

# Optional pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=600

# Integrations
GOOGLE_MAPS_API_KEY=
EXCHANGE_RATE_API_KEY=
PDF_API_KEY=
PDF_MAX_HTML_BYTES=1024000

# Image override used by docker compose / GitHub Actions
# IMAGE=ghcr.io/OWNER/exim-tms:latest
